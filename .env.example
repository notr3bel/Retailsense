# PostgreSQL Data Warehouse Settings
POSTGRES_DB=retailsense_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=retailsense_dev_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# FastAPI Serving & Streamlit Dashboard Settings
API_BASE_URL=http://api:8000
