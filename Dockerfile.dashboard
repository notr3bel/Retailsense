# ============================================================================
# Dockerfile.dashboard — RetailSense-AI Streamlit BI Dashboard Image
# ============================================================================

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install dashboard requirements
COPY requirements-dashboard.txt .
RUN pip install --upgrade pip && pip install -r requirements-dashboard.txt

# Copy dashboard application code, components, utilities, and required runtime data layer
COPY dashboard/ ./dashboard/
COPY database/ ./database/
COPY etl/ ./etl/
COPY data/gold/ ./data/gold/
COPY data/ml/ ./data/ml/
COPY reports/ ./reports/

# Expose Streamlit default port
EXPOSE 8501

# Health check calling Streamlit health endpoint
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Start Streamlit dashboard server
CMD ["streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
